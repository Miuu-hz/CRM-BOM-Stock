import { useState, useEffect, useCallback } from 'react'
import { motion } from 'framer-motion'
import {
  Lock,
  Unlock,
  Calendar,
  TrendingUp,
  TrendingDown,
  AlertTriangle,
  CheckCircle2,
  RefreshCw,
} from 'lucide-react'
import toast from 'react-hot-toast'
import api from '../../services/api'

interface Period {
  id: string
  year: number
  month: number
  period_type: string
  status: 'OPEN' | 'CLOSED' | 'FILING'
  vat_due_date: string
  wht_due_date: string
  je_count: number
}

interface AccountBalance {
  account_id: string
  code: string
  name: string
  balance: number
}

interface YearEndPreview {
  year: number
  revenueRows: AccountBalance[]
  expenseRows: AccountBalance[]
  totalRevenue: number
  totalExpense: number
  netProfit: number
  openMonths: number[]
  alreadyClosed: boolean
  existingEntryNumber: string | null
  retainedEarningsAccountFound: boolean
}

const fmt = (n: number) =>
  (n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })

const STATUS_BADGE: Record<Period['status'], string> = {
  OPEN: 'bg-[var(--success-soft)] text-success',
  CLOSED: 'bg-[var(--surface-sunken)] text-[var(--fg-3)]',
  FILING: 'bg-[var(--warning-soft)] text-warning',
}

export default function PeriodClosing() {
  const [periods, setPeriods] = useState<Period[]>([])
  const [loading, setLoading] = useState(true)
  const [busyId, setBusyId] = useState<string | null>(null)

  const [year, setYear] = useState(new Date().getFullYear())
  const [preview, setPreview] = useState<YearEndPreview | null>(null)
  const [previewLoading, setPreviewLoading] = useState(false)
  const [closing, setClosing] = useState(false)
  const [closedEntry, setClosedEntry] = useState<any>(null)

  const fetchPeriods = useCallback(async () => {
    setLoading(true)
    try {
      const res = await api.get('/period-closing/periods')
      setPeriods(res.data.data)
    } catch {
      toast.error('ไม่สามารถโหลดงวดบัญชีได้')
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => { fetchPeriods() }, [fetchPeriods])

  const fetchPreview = useCallback(async (y: number) => {
    setPreviewLoading(true)
    setClosedEntry(null)
    try {
      const res = await api.get(`/period-closing/year-end-preview/${y}`)
      setPreview(res.data.data)
    } catch {
      toast.error('ไม่สามารถโหลดตัวอย่างการปิดบัญชีสิ้นปีได้')
    } finally {
      setPreviewLoading(false)
    }
  }, [])

  useEffect(() => { fetchPreview(year) }, [year, fetchPreview])

  const handleClose = async (p: Period) => {
    if (!confirm(`ต้องการปิดงวด ${p.month}/${p.year} หรือไม่?`)) return
    setBusyId(p.id)
    try {
      const res = await api.post(`/period-closing/close/${p.id}`)
      toast.success(res.data.message)
      fetchPeriods()
    } catch (err: any) {
      toast.error(err.response?.data?.message || 'ปิดงวดไม่สำเร็จ')
    } finally {
      setBusyId(null)
    }
  }

  const handleReopen = async (p: Period) => {
    if (!confirm(`ต้องการเปิดงวด ${p.month}/${p.year} คืนหรือไม่?`)) return
    setBusyId(p.id)
    try {
      const res = await api.post(`/period-closing/reopen/${p.id}`)
      toast.success(res.data.message)
      fetchPeriods()
    } catch (err: any) {
      toast.error(err.response?.data?.message || 'เปิดงวดคืนไม่สำเร็จ')
    } finally {
      setBusyId(null)
    }
  }

  const handleYearEndClose = async () => {
    if (!preview) return
    const profitLabel = preview.netProfit >= 0 ? `กำไร ${fmt(preview.netProfit)}` : `ขาดทุน ${fmt(Math.abs(preview.netProfit))}`
    if (!confirm(`ยืนยันปิดบัญชีสิ้นปี ${preview.year}? (${profitLabel} บาท) การปิดบัญชีสิ้นปีไม่สามารถแก้ไขย้อนหลังได้`)) return

    setClosing(true)
    try {
      const res = await api.post(`/period-closing/year-end/${preview.year}`)
      toast.success(res.data.message)
      setClosedEntry(res.data.data)
      fetchPeriods()
      fetchPreview(preview.year)
    } catch (err: any) {
      toast.error(err.response?.data?.message || 'ปิดบัญชีสิ้นปีไม่สำเร็จ')
    } finally {
      setClosing(false)
    }
  }

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-[var(--fg-1)] flex items-center gap-2">
            <Lock className="w-6 h-6 text-[var(--primary)]" />
            ปิดงวดบัญชี
          </h1>
          <p className="text-[var(--fg-3)]">ล็อกงวดรายเดือนและปิดบัญชีสิ้นปี</p>
        </div>
        <button onClick={fetchPeriods} className="phopy-btn-secondary flex items-center gap-2">
          <RefreshCw className="w-4 h-4" />
          รีเฟรช
        </button>
      </div>

      {/* Monthly periods table */}
      <div className="phopy-card p-6">
        <h3 className="text-lg font-semibold text-[var(--fg-1)] mb-4 flex items-center gap-2">
          <Calendar className="w-5 h-5 text-[var(--primary)]" />
          งวดรายเดือน
        </h3>
        <div className="overflow-x-auto">
          <table className="phopy-table w-full">
            <thead>
              <tr>
                <th>งวด</th>
                <th>สถานะ</th>
                <th>จำนวนรายการ (JE)</th>
                <th>กำหนดยื่น VAT</th>
                <th>กำหนดยื่น WHT</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {loading ? (
                <tr><td colSpan={6} className="text-center py-8 text-[var(--fg-4)]">กำลังโหลด...</td></tr>
              ) : periods.length === 0 ? (
                <tr><td colSpan={6} className="text-center py-8 text-[var(--fg-4)]">ไม่พบงวดบัญชี</td></tr>
              ) : (
                periods.map((p) => (
                  <tr key={p.id}>
                    <td className="font-medium">{p.month}/{p.year}</td>
                    <td>
                      <span className={`px-2 py-1 rounded text-xs ${STATUS_BADGE[p.status]}`}>
                        {p.status === 'OPEN' ? 'เปิด' : p.status === 'CLOSED' ? 'ปิดแล้ว' : 'กำลังยื่น'}
                      </span>
                    </td>
                    <td>{p.je_count}</td>
                    <td className="text-[var(--fg-3)]">{p.vat_due_date}</td>
                    <td className="text-[var(--fg-3)]">{p.wht_due_date}</td>
                    <td className="text-right">
                      {p.status === 'OPEN' ? (
                        <button
                          disabled={busyId === p.id}
                          onClick={() => handleClose(p)}
                          className="phopy-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1 ml-auto"
                        >
                          <Lock className="w-3.5 h-3.5" />
                          ปิดงวด
                        </button>
                      ) : p.status === 'CLOSED' ? (
                        <button
                          disabled={busyId === p.id}
                          onClick={() => handleReopen(p)}
                          className="phopy-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1 ml-auto"
                        >
                          <Unlock className="w-3.5 h-3.5" />
                          เปิดคืน
                        </button>
                      ) : null}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* Year-end closing */}
      <div className="phopy-card p-6">
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-lg font-semibold text-[var(--fg-1)] flex items-center gap-2">
            <TrendingUp className="w-5 h-5 text-[var(--primary)]" />
            ปิดบัญชีสิ้นปี
          </h3>
          <select
            value={year}
            onChange={(e) => setYear(Number(e.target.value))}
            className="phopy-input"
          >
            {Array.from({ length: 6 }, (_, i) => new Date().getFullYear() - i).map((y) => (
              <option key={y} value={y}>{y}</option>
            ))}
          </select>
        </div>

        {previewLoading ? (
          <div className="text-center py-8 text-[var(--fg-4)]">กำลังคำนวณ...</div>
        ) : preview ? (
          <div className="space-y-4">
            {preview.openMonths.length > 0 && (
              <div className="p-4 rounded-lg border bg-[var(--warning-soft)] border-warning/30 flex items-center gap-2">
                <AlertTriangle className="w-5 h-5 text-warning shrink-0" />
                <span className="text-warning">
                  งวด {preview.openMonths.map((m) => `${m}/${preview.year}`).join(', ')} ยังไม่ได้ปิด — ต้องปิดงวดรายเดือนทั้งหมดก่อนปิดบัญชีสิ้นปี
                </span>
              </div>
            )}

            {!preview.retainedEarningsAccountFound && (
              <div className="p-4 rounded-lg border bg-[var(--danger-soft)] border-danger/30 flex items-center gap-2">
                <AlertTriangle className="w-5 h-5 text-danger shrink-0" />
                <span className="text-danger">ไม่พบบัญชีกำไรสะสม (3103) ในผังบัญชี กรุณาสร้างก่อนปิดบัญชีสิ้นปี</span>
              </div>
            )}

            {preview.alreadyClosed && (
              <div className="p-4 rounded-lg border bg-[var(--info-soft)] border-info/30 flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-blue-400 shrink-0" />
                <span className="text-blue-400">ปิดบัญชีสิ้นปี {preview.year} ไปแล้ว (เลขที่ {preview.existingEntryNumber})</span>
              </div>
            )}

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div className="p-4 bg-[var(--surface-2)] rounded-lg">
                <p className="text-sm text-[var(--fg-3)]">รายได้รวม</p>
                <p className="text-xl font-bold text-success">{fmt(preview.totalRevenue)}</p>
              </div>
              <div className="p-4 bg-[var(--surface-2)] rounded-lg">
                <p className="text-sm text-[var(--fg-3)]">ค่าใช้จ่ายรวม</p>
                <p className="text-xl font-bold text-danger">{fmt(preview.totalExpense)}</p>
              </div>
              <div className="p-4 bg-[var(--surface-2)] rounded-lg">
                <p className="text-sm text-[var(--fg-3)] flex items-center gap-1">
                  {preview.netProfit >= 0 ? <TrendingUp className="w-4 h-4 text-success" /> : <TrendingDown className="w-4 h-4 text-danger" />}
                  {preview.netProfit >= 0 ? 'กำไรสุทธิ' : 'ขาดทุนสุทธิ'}
                </p>
                <p className={`text-xl font-bold ${preview.netProfit >= 0 ? 'text-success' : 'text-danger'}`}>
                  {fmt(Math.abs(preview.netProfit))}
                </p>
              </div>
            </div>

            {(preview.revenueRows.length > 0 || preview.expenseRows.length > 0) && (
              <div className="overflow-x-auto">
                <table className="phopy-table w-full">
                  <thead>
                    <tr>
                      <th>บัญชี</th>
                      <th>ประเภท</th>
                      <th className="text-right">ยอดปิดบัญชี</th>
                    </tr>
                  </thead>
                  <tbody>
                    {preview.revenueRows.map((r) => (
                      <tr key={r.account_id}>
                        <td>{r.code} {r.name}</td>
                        <td><span className="text-success text-xs">รายได้ (เดบิต)</span></td>
                        <td className="text-right">{fmt(r.balance)}</td>
                      </tr>
                    ))}
                    {preview.expenseRows.map((r) => (
                      <tr key={r.account_id}>
                        <td>{r.code} {r.name}</td>
                        <td><span className="text-danger text-xs">ค่าใช้จ่าย (เครดิต)</span></td>
                        <td className="text-right">{fmt(r.balance)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <button
              disabled={closing || preview.alreadyClosed || preview.openMonths.length > 0 || !preview.retainedEarningsAccountFound}
              onClick={handleYearEndClose}
              className="phopy-btn-primary w-full flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <Lock className="w-4 h-4" />
              {closing ? 'กำลังปิดบัญชี...' : `ปิดบัญชีสิ้นปี ${preview.year}`}
            </button>

            {closedEntry && (
              <div className="p-4 bg-[var(--surface-2)] rounded-lg space-y-2">
                <p className="text-sm text-[var(--fg-2)] font-medium">
                  รายการปิดบัญชี: {closedEntry.entry_number} วันที่ {closedEntry.date}
                </p>
                <div className="overflow-x-auto">
                  <table className="phopy-table w-full">
                    <thead>
                      <tr>
                        <th>บัญชี</th>
                        <th>รายละเอียด</th>
                        <th className="text-right">เดบิต</th>
                        <th className="text-right">เครดิต</th>
                      </tr>
                    </thead>
                    <tbody>
                      {(closedEntry.lines || []).map((l: any) => (
                        <tr key={l.id}>
                          <td>{l.account_code} {l.account_name}</td>
                          <td className="text-[var(--fg-4)]">{l.description}</td>
                          <td className="text-right">{l.debit ? fmt(l.debit) : ''}</td>
                          <td className="text-right">{l.credit ? fmt(l.credit) : ''}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        ) : null}
      </div>
    </motion.div>
  )
}
